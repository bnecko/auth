# Crypto: everything that touches money or a chain. A deployment that does not
# want any of it keeps this file as it is here.
#
# One switch for all of it: TON wallet linking, donations, the btGRAM ledger,
# the public pool, withdrawals, and the identity check that gates them. Only
# the exact value "true" turns it on; unset or anything else leaves it off,
# where the pages and APIs answer 404, their links disappear, the two OAuth
# scopes stop being offered, and the worker does not start its chain loops.
# Read by both the app and the worker. Turning it off does not touch stored
# balances, and deposits that arrive meanwhile are picked up from the saved
# cursor once it is back on. The other variables in this file do nothing while
# it is off.
CRYPTO_ENABLED=false

# TON chain reads: which .ton domains a verified wallet owns, and the
# periodic re-check of any domain shown on a profile. Both the app and the
# worker use them. Optional: the public tier answers without a key, just
# more slowly, and without either the wallet still links and the address
# still displays, only domains stop working.
TON_INDEXER_URL=
TONCENTER_API_KEY=

# Raw-form address (0:<64 hex>) that receives donations. Watch-only: no key
# for it is ever held here. Must be a deployed (active) wallet, because
# transfers into an uninitialised account show as aborted and would all be
# refused. Unset means the donation sweep does nothing.
TON_DONATION_ADDRESS=

# Didit identity verification (app process only; the worker does no KYC).
# DIDIT_WEBHOOK_SECRET is the destination's "secret shared key" from the
# Business Console, used to verify the HMAC on every delivery. Documents stay
# with Didit: this service stores a session reference and a decision.
DIDIT_API_KEY=
# The workflow to run, from the Business Console. No session can be opened
# without it, so verification stays unavailable until it is set.
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=
